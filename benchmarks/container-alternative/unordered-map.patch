diff --git a/include/detent/detail/ordered_snapshot.hh b/include/detent/detail/ordered_snapshot.hh
new file mode 100644
index 0000000..67bf6fc
--- /dev/null
+++ b/include/detent/detail/ordered_snapshot.hh
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <detent/model.hh>
+
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+namespace detent::detail {
+
+inline auto ordered_snapshot_entries(const Snapshot& snapshot) {
+    using Entry = decltype(snapshot.knobs)::value_type;
+    std::vector<const Entry*> entries;
+    entries.reserve(snapshot.knobs.size());
+    for (const auto& entry : snapshot.knobs)
+        entries.push_back(std::addressof(entry));
+    std::sort(entries.begin(), entries.end(), [](const Entry* a, const Entry* b) {
+        return a->first < b->first;
+    });
+    return entries;
+}
+
+} // namespace detent::detail
