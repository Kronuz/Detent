set(root "${CMAKE_CURRENT_BINARY_DIR}/agent-cli")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/config/detent")
file(WRITE "${root}/defaults.json" "{\"schema_version\":1,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":25}}}")
set(env "${CMAKE_COMMAND}" -E env --unset=DETENT_DEFAULTS_PATH --unset=DETENT_SOURCE_ADDRESS --unset=DETENT_SOURCE_HTTP --unset=DETENT_SOURCE_PATH --unset=DETENT_POLL_INTERVAL_MS "DETENT_RUNTIME_DIR=${root}/run" "XDG_CONFIG_HOME=${root}/config")
function(stop_agent)
  execute_process(COMMAND ${env} "${AGENT}" --status OUTPUT_VARIABLE status ERROR_QUIET)
  if(status MATCHES "pid ([0-9]+)")
    execute_process(COMMAND /bin/kill -TERM "${CMAKE_MATCH_1}")
    foreach(attempt RANGE 1 50)
      execute_process(COMMAND ${env} "${AGENT}" --status RESULT_VARIABLE alive OUTPUT_QUIET ERROR_QUIET)
      if(NOT alive EQUAL 0)
        return()
      endif()
      execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 0.1)
    endforeach()
    message(FATAL_ERROR "agent did not stop")
  endif()
endfunction()
function(check expected_code expected_output)
  set(binary "${AGENT}")
  if("${ARGV2}" STREQUAL "get")
    set(binary "${READER}")
  endif()
  execute_process(COMMAND ${env} "${binary}" ${ARGN} WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL expected_code OR NOT "${output}${error}" MATCHES "${expected_output}")
    stop_agent()
    file(GLOB_RECURSE daemon_logs "${root}/*agent.log")
    foreach(log IN LISTS daemon_logs)
      file(READ "${log}" diagnostic LIMIT 65536)
      string(APPEND error "\n${log}:\n${diagnostic}")
    endforeach()
    message(FATAL_ERROR "${ARGN}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
endfunction()
foreach(arguments IN ITEMS "--bogus" "--bogus;--default;-4" "--hash" "--switch;--system" "extra")
  execute_process(COMMAND ${env} "${READER}" get search:max_results ${arguments}
    WORKING_DIRECTORY "${root}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL 1 OR NOT output STREQUAL "" OR error MATCHES "auto-start|startup failed")
    message(FATAL_ERROR "invalid arguments ${arguments}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
  if(EXISTS "${root}/run")
    message(FATAL_ERROR "invalid reader arguments created runtime artifacts")
  endif()
endforeach()
check(0 "-4" get search:missing --system --default -4)
check(0 "25" get search:max_results --defaults defaults.json)
check(0 "running" --status)
stop_agent()
# A stopped daemon leaves a snapshot behind: get must still restart it.
file(WRITE "${root}/custom.json" "{\"schema_version\":1,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":42}}}")
check(0 "42" get search:max_results --defaults custom.json)
check(0 "running" --status)
stop_agent()
file(REMOVE_RECURSE "${root}/run")
check(1 "defaults file" get search:max_results --defaults missing.json)
check(1 "not running" --status)
check(1 "defaults file" --daemonize --defaults missing.json)
check(0 "99" get search:max_results --defaults missing.json --default 99)
# Standard config discovery, config-relative paths, source-only first read.
file(WRITE "${root}/config/detent/live.json" "{\"schema_version\":1,\"version\":1,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":73}}}")
file(WRITE "${root}/config/detent/agent.json" "{\"source_path\":\"live.json\",\"poll_interval_ms\":10,\"runtime_dir\":\"run\"}")
# No DETENT_* settings: only XDG discovery.
set(env "${CMAKE_COMMAND}" -E env --unset=DETENT_DEFAULTS_PATH --unset=DETENT_SOURCE_ADDRESS --unset=DETENT_SOURCE_HTTP --unset=DETENT_SOURCE_PATH --unset=DETENT_POLL_INTERVAL_MS --unset=DETENT_RUNTIME_DIR "XDG_CONFIG_HOME=${root}/config" "TMPDIR=${root}")
check(0 "73" get search:max_results)
check(0 "version=1" --status)
stop_agent()
file(WRITE "${root}/override.json" "{\"schema_version\":1,\"version\":2,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":81}}}")
check(0 "81" get search:max_results --source-path override.json)
stop_agent()
# A conventional defaults.json is discovered, but never auto-created.
file(WRITE "${root}/config/detent/agent.json" "{}")
file(COPY_FILE "${root}/defaults.json" "${root}/config/detent/defaults.json")
check(0 "25" get search:max_results)
stop_agent()
file(REMOVE "${root}/config/detent/defaults.json")
# Source failure leaves a running agent which can recover.
check(1 "no snapshot received" get search:max_results --source-path absent.json)
check(0 "running" --status)
check(0 "99" get search:max_results --default 99)
stop_agent()
file(WRITE "${root}/config/detent/agent.json" "{\"typo\":true}")
check(1 "unknown field: typo" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{\"source_address\":\"localhost:8080\",\"source_address\":\"localhost:8081\"}")
check(1 "duplicate field" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{\"source_address\":\"localhost:bad\"}")
check(1 "source_address port" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{}")
check(1 "cannot open file" get search:max_results --config missing-config.json)
file(REMOVE_RECURSE "${root}")
