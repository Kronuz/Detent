set(root "${CMAKE_CURRENT_BINARY_DIR}/agent-cli")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/config/detent")
file(WRITE "${root}/defaults.json" "{\"schema_version\":1,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":25}}}")
set(env "${CMAKE_COMMAND}" -E env --unset=DETENT_DEFAULTS_PATH "DETENT_RUNTIME_DIR=${root}/run" "XDG_CONFIG_HOME=${root}/config")
function(check expected_code expected_output)
  set(binary "${AGENT}")
  if("${ARGV2}" STREQUAL "get")
    set(binary "${READER}")
  endif()
  execute_process(COMMAND ${env} "${binary}" ${ARGN} WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL expected_code OR NOT "${output}${error}" MATCHES "${expected_output}")
    file(GLOB_RECURSE daemon_logs "${root}/*agent.log")
    foreach(log IN LISTS daemon_logs)
      file(READ "${log}" diagnostic LIMIT 65536)
      string(APPEND error "\n${log}:\n${diagnostic}")
    endforeach()
    message(FATAL_ERROR "${ARGN}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
endfunction()
foreach(arguments IN ITEMS "--bogus" "--bogus;--default;-4" "--hash" "--switch;--system" "extra")
  execute_process(COMMAND ${env} "${READER}" get search:max_results ${arguments}
    WORKING_DIRECTORY "${root}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL 1 OR NOT output STREQUAL "" OR error MATCHES "auto-start|startup failed")
    message(FATAL_ERROR "invalid arguments ${arguments}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
  if(EXISTS "${root}/run")
    message(FATAL_ERROR "invalid reader arguments created runtime artifacts")
  endif()
endforeach()
check(0 "-4" get search:missing --system --default -4)
check(1 "ERR" get search:missing --system)
check(0 "25" get search:max_results --defaults defaults.json)
check(1 "defaults file" get search:max_results --defaults missing.json)
check(1 "defaults file" get search:max_results --defaults missing.json --default 99)
check(1 "not running" --status)
check(1 "requires --managed" --daemonize --defaults defaults.json)
# A conventional defaults.json is discovered, but never auto-created.
file(WRITE "${root}/config/detent/agent.json" "{}")
file(COPY_FILE "${root}/defaults.json" "${root}/config/detent/defaults.json")
check(0 "25" get search:max_results)
file(REMOVE "${root}/config/detent/defaults.json")
file(WRITE "${root}/config/detent/agent.json" "{\"typo\":true}")
check(1 "unknown field: typo" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{\"source_address\":\"localhost:8080\"}")
check(1 "unknown field: source_address" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{\"defaults_path\":\"a.json\",\"defaults_path\":\"b.json\"}")
check(1 "duplicate field" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{}")
check(1 "cannot open file" get search:max_results --config missing-config.json)
file(REMOVE_RECURSE "${root}")
