set(root "${CMAKE_CURRENT_BINARY_DIR}/agent-cli")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/config/detent")
file(WRITE "${root}/defaults.json" "{\"schema_version\":1,\"knobs\":{\"search:max_results\":{\"type\":\"int\",\"default\":25}}}")
set(env "${CMAKE_COMMAND}" -E env --unset=DETENT_DEFAULTS_PATH --unset=DETENT_MANAGED_CONFIG --unset=DETENT_GENERATION_DIR --unset=DETENT_SOURCE_PATH "DETENT_RUNTIME_DIR=${root}/run" "XDG_CONFIG_HOME=${root}/config")
function(check expected_code expected_output)
  set(binary "${AGENT}")
  if("${ARGV2}" STREQUAL "get")
    set(binary "${READER}")
  endif()
  execute_process(COMMAND ${env} "${binary}" ${ARGN} WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL expected_code OR NOT "${output}${error}" MATCHES "${expected_output}")
    message(FATAL_ERROR "${ARGN}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
endfunction()
function(check_no_runtime)
  if(EXISTS "${root}/run")
    message(FATAL_ERROR "a rejected command created runtime artifacts")
  endif()
endfunction()
foreach(arguments IN ITEMS "--bogus" "--bogus;--default;-4" "--hash" "--switch;--system" "extra")
  execute_process(COMMAND ${env} "${READER}" get search:max_results ${arguments}
    WORKING_DIRECTORY "${root}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT code EQUAL 1 OR NOT output STREQUAL "" OR error MATCHES "auto-start|startup failed")
    message(FATAL_ERROR "invalid arguments ${arguments}: exit=${code}, stdout=${output}, stderr=${error}")
  endif()
  check_no_runtime()
endforeach()
# Starting or reading with no source configured is a hard error, whatever fallbacks are given.
check(1 "no source configured" get search:max_results)
check(1 "no source configured" get search:max_results --default 99)
check(1 "no source configured" get search:max_results --defaults defaults.json)
check(1 "no source configured" get search:max_results --system)
check(1 "no source configured")
check(1 "no source configured" --daemonize)
check(1 "no source configured" --system)
check(1 "no source configured" --initialize-managed)
check_no_runtime()
check(1 "not running" --status)
# The unmanaged file, poll and HTTP sources are gone.
foreach(flag IN ITEMS --source-path --poll-interval-ms --source-address)
  check(1 "unknown argument: ${flag}" ${flag} x)
  check(1 "unknown argument: ${flag}" get search:max_results ${flag} x)
endforeach()
foreach(field IN ITEMS source_path poll_interval_ms source_address)
  file(WRITE "${root}/config/detent/agent.json" "{\"${field}\":\"x\"}")
  check(1 "unknown field: ${field}" get search:max_results)
  check(1 "unknown field: ${field}" --status)
endforeach()
file(WRITE "${root}/config/detent/agent.json" "{\"typo\":true}")
check(1 "unknown field: typo" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{\"runtime_dir\":\"a\",\"runtime_dir\":\"b\"}")
check(1 "duplicate field" get search:max_results)
file(WRITE "${root}/config/detent/agent.json" "{}")
check(1 "cannot open file" get search:max_results --config missing-config.json)
# A configured generation directory is the source; with no generation yet, baked defaults answer.
check(0 "25" get search:max_results --generation-dir missing --defaults defaults.json)
check(0 "99" get search:max_results --generation-dir missing --default 99)
check_no_runtime()
file(REMOVE_RECURSE "${root}")
