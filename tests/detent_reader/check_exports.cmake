# Fails unless the shared library at LIBRARY defines exactly the functions LIST names (and the
# linker's own symbols): nothing missing, nothing extra.
cmake_minimum_required(VERSION 3.24) # IN_LIST (CMP0057) in script mode
find_program(NM nm REQUIRED)
if(APPLE)
  set(flags -gU)
else()
  set(flags -D --defined-only)
endif()
execute_process(COMMAND "${NM}" ${flags} "${LIBRARY}" OUTPUT_VARIABLE listing RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "nm failed on ${LIBRARY}")
endif()
file(STRINGS "${LIST}" expected)
string(REPLACE "\n" ";" lines "${listing}")
set(exported "")
foreach(line IN LISTS lines)
  if(line MATCHES "^[0-9a-fA-F]* +[A-Za-z] +(.+)$")
    set(symbol "${CMAKE_MATCH_1}")
    if(APPLE)
      string(REGEX REPLACE "^_" "" symbol "${symbol}")
    endif()
    if(symbol MATCHES "^_(init|fini|edata|end|bss_start)$" OR symbol STREQUAL "__bss_start")
      continue()
    endif()
    if(NOT symbol IN_LIST expected)
      message(FATAL_ERROR "${LIBRARY} exports ${symbol}, which ${LIST} does not list")
    endif()
    list(APPEND exported "${symbol}")
  endif()
endforeach()
foreach(symbol IN LISTS expected)
  if(NOT symbol IN_LIST exported)
    message(FATAL_ERROR "${LIBRARY} does not export ${symbol}")
  endif()
endforeach()
list(LENGTH expected count)
message(STATUS "${LIBRARY}: exactly the ${count} functions ${LIST} lists")
