<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>org.detent.prepare-runtime</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/install</string>
		<string>-d</string>
		<string>-o</string>
		<string>_detent</string>
		<string>-g</string>
		<string>_detent</string>
		<string>-m</string>
		<string>0755</string>
		<string>/var/run/detent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
