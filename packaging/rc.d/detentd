#!/bin/sh
# PROVIDE: detentd
# REQUIRE: NETWORKING
# KEYWORD: shutdown
. /etc/rc.subr
name="detentd"
rcvar="detentd_enable"
load_rc_config "$name"
: ${detentd_enable:="NO"}
pidfile="/var/run/detent/detentd-supervisor.pid"
start_precmd="detent_directories"
detent_directories() {
    install -d -o detent -g detent -m 0755 /var/run/detent
    install -d -o detent -g detent -m 0700 /var/db/detent
    install -d -o detent -g detent -m 0750 /var/log/detent
}
command="/usr/sbin/daemon"
procname="/usr/local/bin/detentd"
command_args="-r -P ${pidfile} -u detent -o /var/log/detent/detentd.log ${procname} --system --config /usr/local/etc/detent/detentd.json"
run_rc_command "$1"
