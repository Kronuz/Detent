# The read path through libdetent_reader. One flow, top to bottom: the
# three entry points converge, and any error returns the caller's fallback.
direction: down

app: "reader.eval() / get() / lookup()" {
  shape: rectangle
}

validate: "validate ns:key\n(and the handle's namespaces)" {
  shape: rectangle
}

pin: "pin the view\n(one stripe counter)" {
  shape: rectangle
}

sequence: "load the namespace's\nchange sequence\n(one acquire)" {
  shape: rectangle
}

change: change file\n(mapped read-only) {
  shape: cylinder
}

attach: "attach the newer\ngeneration\n(one winner)" {
  shape: rectangle
}

walk: "trie walk\n(verified pages,\none bit test each)" {
  shape: rectangle
}

evaluate: "type check + evaluate\n(switch > rollout > default)" {
  shape: rectangle
}

hashing: stable_bucket()\n(SHA-256) {
  shape: rectangle
}

fallback: "caller's fallback\n(+ status from lookup())" {
  shape: page
}

app -> validate -> pin -> sequence -> walk -> evaluate
sequence -> change: "read"
sequence -> attach: "moved"
attach -> walk
evaluate -> hashing: "only if\nrollout_pct set"
evaluate -> fallback: "any error" {
  style.stroke-dash: 4
}
