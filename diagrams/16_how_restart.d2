vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent
direction: right

ready: "Restart\nno pack hashed"
touch: "First touch\nchecks a page"
scrub: "Scrub\nhashes packs"
damage: "Damage\nreported" {style.fill: "#E8E2F0"}
repair: "Repair\n(S3b)" {style.stroke-dash: 4}

ready -> touch
ready -> scrub
touch -> damage
scrub -> damage
damage -> repair {style.stroke-dash: 4}
