# Selected targets and their direct dependencies.
# Managed authority and generation targets are documented separately.
direction: down

detent: "detent\n(core lib)" {
  tooltip: RCU client, JSON schema, hashing, overrides, file source
}
delivery_config: "delivery_config" {
  tooltip: Managed delivery over TLS and local publication
}
detentd_exe: "detentd (exe)" {
  tooltip: Durable authority daemon
}
detent_agent_exe: "detent-agent (exe)"

kronuz: Kronuz cpp-libraries used directly by detent {
  char_classify: char-classify {tooltip: "ASCII classification tables used by the JSON tokenizer"}
  strict_stox: strict-stox {tooltip: "Strict numeric string parsing (no silent truncation) for knob values"}
  atomic_shared_ptr: atomic-shared-ptr {tooltip: "Lock-free RCU snapshot swap -- the whole read-path fast path depends on this"}
  random: random {tooltip: "Randomized source retry and backoff jitter"}
  sha256: sha256 {tooltip: "Rollout hashing per the JustKnobs spec (stable bucket assignment)"}
}

thirdparty: Third-party (see 09_thirdparty_deps.d2 for their own deps) {
  http: "http" {tooltip: "HTTP server framework for the authority endpoints"}
}

detent -> kronuz.char_classify
detent -> kronuz.strict_stox
detent -> kronuz.atomic_shared_ptr
detent -> kronuz.random
detent -> kronuz.sha256

detentd_exe -> detent
detentd_exe -> thirdparty.http: "serves the authority endpoints"

delivery_config -> detent
detent_agent_exe -> delivery_config
