# Selected classic-profile targets and their direct dependencies.
# Managed authority and generation targets are documented separately.
direction: down

detent: "detent\n(core lib)" {
  tooltip: RCU client, JSON schema, hashing, overrides, file source
}
detent_http: "detent_http" {
  tooltip: HTTP polling client -- plain POSIX sockets, no reactor
}
detentd_lib: "detentd_lib" {
  tooltip: HTTP distributor daemon logic
}
detent_agent_lib: "detent_agent_lib" {
  tooltip: Shared-memory agent reader and writer logic
}
detentd_exe: "detentd (exe)"
detent_agent_exe: "detent-agent (exe)"

kronuz: Kronuz cpp-libraries used directly by detent {
  char_classify: char-classify {tooltip: "ASCII classification tables used by the JSON tokenizer"}
  strict_stox: strict-stox {tooltip: "Strict numeric string parsing (no silent truncation) for knob values"}
  atomic_shared_ptr: atomic-shared-ptr {tooltip: "Lock-free RCU snapshot swap -- the whole read-path fast path depends on this"}
  cpp_btree: cpp-btree {tooltip: "Ordered map for the knob table, better cache behavior than std::map"}
  random: random {tooltip: "Randomized source retry and backoff jitter"}
  sha256: sha256 {tooltip: "Rollout hashing per the JustKnobs spec (stable bucket assignment)"}
  compressors: compressors {tooltip: "zstd/gzip codecs -- lets detent_http negotiate Accept-Encoding on its own, no HTTP-framework weight"}
}

thirdparty: Third-party (see 09_thirdparty_deps.d2 for their own deps) {
  http: "http" {tooltip: "HTTP server framework for /v1/snapshot and /v1/health"}
  cluster: "cluster" {tooltip: "Raft replication over configured UDP peers"}
}

detent -> kronuz.char_classify
detent -> kronuz.strict_stox
detent -> kronuz.atomic_shared_ptr
detent -> kronuz.cpp_btree
detent -> kronuz.random
detent -> kronuz.sha256

detent_http -> detent: "reuses Client + snapshot model"
detent_http -> kronuz.compressors: "Accept-Encoding: zstd, gzip on its own GETs"

detentd_lib -> detent
detentd_lib -> detent_http: "polls upstream/peers over HTTP"
detentd_lib -> thirdparty.http: "serves GET/PUT/PATCH /v1/snapshot"
detentd_lib -> thirdparty.cluster: "replicates committed snapshots through Raft"
detentd_exe -> detentd_lib

detent_agent_lib -> detent: "one warm in-process snapshot per agent"
detent_agent_exe -> detent_agent_lib
detent_agent_exe -> detent_http: "classic --source-address mode" {style.stroke-dash: 4}
