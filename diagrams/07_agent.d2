# The host-local managed agent: one TLS delivery per host, published as
# immutable generations on disk. Every local reader maps the selected
# generation read-only instead of round-tripping to a daemon.
direction: down

authority: detentd\n(authority, remote) {
  shape: rectangle
}

agent: detent-agent\n(managed delivery) {
  shape: rectangle
}

store: generation_dir\n(immutable images,\nselected descriptor) {
  shape: cylinder
}

reader_a: shell script /\n`detent get` {
  shape: rectangle
}

reader_b: another local\nprocess (any language) {
  shape: rectangle
}

authority -> agent: "snapshot / delta over TLS\n(one connection for\nthe whole host)"
agent -> store: "build, validate, select\non every accepted update"
store -> reader_a: "lease + mmap read-only\n(no daemon round-trip)"
store -> reader_b: "lease + mmap read-only\n(no daemon round-trip)"
