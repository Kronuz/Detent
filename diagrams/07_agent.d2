# The host-local agent: it receives snapshots and deltas from the authority
# or a relay, builds an immutable generation, and selects it atomically.
# Every local reader leases and maps the selected generation read-only, so a
# read never round-trips to the daemon.
direction: down

upstream: authority or relay {
  shape: rectangle
}

agent: detent-agent\n(managed) {
  shape: rectangle
}

generations: generation_dir\n(selected + immutable\ngenerations) {
  shape: cylinder
}

reader_a: shell script /\n`detent get` {
  shape: rectangle
}

reader_b: another local\nprocess (any language) {
  shape: rectangle
}

upstream -> agent: "snapshots and deltas\n(one connection for\nthe whole host)"
agent -> generations: "build image,\nswap descriptor"
generations -> reader_a: "lease + mmap PROT_READ\n(no daemon round-trip)"
generations -> reader_b: "lease + mmap PROT_READ\n(no daemon round-trip)"
