# Classic distributor Raft replication over the configured UDP bus.
direction: right

client: HTTP writer
leader: Leader distributor
bus: "UDP Raft RPCs\n(cluster::Bus)" {shape: queue}
follower: Follower distributor
peer: Second follower

client -> follower: "PUT/PATCH /v1/snapshot"
follower -> leader: "forward write"
leader -> bus: "replicate log entries"
bus -> follower: "append entries"
bus -> peer: "append entries"
follower -> bus: "acknowledge"
peer -> bus: "acknowledge"
bus -> leader: "majority commits"
