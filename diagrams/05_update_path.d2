# The update path: the managed agent turns one delivery into a new
# generation, and readers see it on their next lookup.
direction: down

delivery: "managed delivery\n(snapshot or delta over TLS)" {
  shape: rectangle
}

validate: "decode + validate\n(SnapshotDecoder)" {
  shape: rectangle
}

build: "build pages along\nthe changed paths" {
  shape: rectangle
}

write: "write packs and records,\nsync" {
  shape: rectangle
}

select: "rename selected,\nsync the directory" {
  shape: rectangle
}

bump: "bump change\n(entry sequence,\nthen store word)" {
  shape: rectangle
}

readers: "readers' next lookup\nattaches the generation" {
  shape: rectangle
}

backoff: "full-jitter backoff\n(random lib)" {
  shape: rectangle
}

delivery -> validate
validate -> build: "valid"
validate -> backoff: "invalid or\nfailed" {
  style.stroke-dash: 4
}
build -> write -> select -> bump -> readers
backoff -> delivery: "retry"
