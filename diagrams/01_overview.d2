# The top-level flow, deliberately minimal: three actors, no internals.
# See 02_distributor_internals.d2, 03_gossip.d2, 04_read_path.d2, and
# 05_update_path.d2 for what's inside each box.
direction: down

publisher: Publisher {
  shape: person
}

distributor: Distributor\n(detentd) {
  shape: rectangle
}

client: App process\n(detent::Client) {
  shape: rectangle
}

defaults: Baked defaults\n(just_knobs.json) {
  shape: page
}

publisher -> distributor: "PUT /v1/snapshot\n(publish a new version)"
distributor -> client: "GET /v1/snapshot\n(conditional poll,\nevery poll_interval)"
defaults -> client: "loaded at init()\nas version 0"
