# The top-level flow, deliberately minimal: four actors, no internals.
# See 04_read_path.d2, 05_update_path.d2 and 07_agent.d2 for what's inside
# each box.
direction: down

publisher: Publisher {
  shape: person
}

authority: Authority\n(detentd) {
  shape: rectangle
}

agent: Host agent\n(detent-agent) {
  shape: rectangle
}

reader: App process or\n`detent get` {
  shape: rectangle
}

defaults: Baked defaults\n(just_knobs.json) {
  shape: page
}

publisher -> authority: "POST /v2/transactions\n(atomic, per-namespace)"
authority -> agent: "managed delivery\n(snapshot or delta over TLS)"
agent -> reader: "immutable local\ngenerations"
defaults -> reader: "baked fallback\nfor missing knobs"
