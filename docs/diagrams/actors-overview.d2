vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent
grid-rows: 2
grid-columns: 3
horizontal-gap: 130
vertical-gap: 170

producer: "Producer\nyour service, curl"
authority: "Authority\n3 voters\ndetentd --authority" {style.multiple: true}
relay: "Relay (optional)\ndetent-relay"
client: "Client\nyour app or detent get"
gens: "Generations\n(files on the host)" {shape: cylinder; style.fill: "#E8E2F0"}
agent: "Agent, one per host\ndetent-agent"

producer -> authority: "write"
authority -> relay: "subscribe"
relay -> agent: "updates"
authority -> agent: "or direct" {style.stroke-dash: 4}
agent -> gens: "publish"
client -> gens: "map, read"
