vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent
grid-rows: 2
grid-columns: 3
horizontal-gap: 110
vertical-gap: 160

s1: "1. Producer\nPOST /v2/transactions\nto the leader"
s2: "2. Leader voter\nappends the entry,\nreplicates to followers"
s3: "3. Majority durable\nentry applied,\nproducer gets revision"
s6: "6. Client\nsees the new selection,\nreads from memory" {style.fill: "#E8E2F0"}
s5: "5. Agent\nwrites a generation,\nswaps selected"
s4: "4. Relay\nreceives the delta,\npublishes its generation"

s1 -> s2
s2 -> s3
s3 -> s4: "delta"
s4 -> s5: "delta"
s5 -> s6: "refresh"
