@@ -0,0 +1,25 @@
+#pragma once
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdlib.h>
+
+namespace kronuz::io::completion::detail {
+// Exploration probe (Detent explore/cold-bootstrap): counts device flushes; with
+// DETENT_STAGED_SYNC naming this program, a file sync stages (fsync) and image
+// preparations skip their directory barrier, leaving the flush to the publication.
+struct SyncProbe {
+	std::atomic<unsigned long long> full{0}, staged{0}, directory{0};
+	bool staged_mode = [] {
+		const char *v = std::getenv("DETENT_STAGED_SYNC");
+		return v && std::strcmp(v, getprogname()) == 0;
+	}();
+	~SyncProbe() {
+		if (std::getenv("DETENT_PROBE_SYNC"))
+			std::fprintf(stderr, "sync-probe %s full=%llu staged=%llu directory=%llu staged_mode=%d\n", getprogname(),
+						 full.load(), staged.load(), directory.load(), int(staged_mode));
+	}
+};
+inline SyncProbe sync_probe;
+} // namespace kronuz::io::completion::detail
